# Prevent directory browsing without changing normal application routing.
Options -Indexes

# Service Workers require a secure context. Keep localhost usable for XAMPP,
# while forcing the deployed host onto TLS.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^(?:localhost|127\.0\.0\.1)(?::\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # Keep the authentication page at the site's clean root URL. Direct visits
    # to the old file URL are redirected; the root is served internally.
    RewriteCond %{THE_REQUEST} \s/+[^?\ ]*pages/login\.html(?:[?\ ]|$) [NC]
    RewriteCond %{REQUEST_URI} ^(.*/)pages/login\.html$ [NC]
    RewriteRule ^pages/login\.html$ %1 [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+[^?\ ]*pages/studentDashboard\.html(?:[?\ ]|$) [NC]
    RewriteCond %{REQUEST_URI} ^(.*/)pages/studentDashboard\.html$ [NC]
    RewriteRule ^pages/studentDashboard\.html$ %1student/ [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+[^?\ ]*pages/officerDashboard\.html(?:[?\ ]|$) [NC]
    RewriteCond %{REQUEST_URI} ^(.*/)pages/officerDashboard\.html$ [NC]
    RewriteRule ^pages/officerDashboard\.html$ %1officer/ [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+[^?\ ]*pages/osaDashboard\.html(?:[?\ ]|$) [NC]
    RewriteCond %{REQUEST_URI} ^(.*/)pages/osaDashboard\.html$ [NC]
    RewriteRule ^pages/osaDashboard\.html$ %1osa/ [R=301,L,NE]

    RewriteCond %{REQUEST_URI} ^(.*/)student$ [NC]
    RewriteRule ^student$ %1student/ [R=301,L,NE]
    RewriteCond %{REQUEST_URI} ^(.*/)officer$ [NC]
    RewriteRule ^officer$ %1officer/ [R=301,L,NE]
    RewriteCond %{REQUEST_URI} ^(.*/)osa$ [NC]
    RewriteRule ^osa$ %1osa/ [R=301,L,NE]

    RewriteRule ^$ pages/login.html [L]
    RewriteRule ^student/$ pages/studentDashboard.html [L]
    RewriteRule ^officer/$ pages/officerDashboard.html [L]
    RewriteRule ^osa/$ pages/osaDashboard.html [L]
</IfModule>

<IfModule mod_headers.c>
    <Files "sw.js">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Block development manifests, environment templates, session artifacts, and
# project documentation from direct HTTP access. These files remain readable
# by PHP, Composer, and command-line deployment tools on the server.
<FilesMatch "(?i)^(?:composer\.(?:json|lock|phar)|package(?:-lock)?\.json|\.env(?:\..*)?|\.git(?:ignore|attributes|modules)?|sess_[A-Za-z0-9_-]+|__[^/]+\.tmp|TO[ _-]?DO\.txt|.+\.(?:md|mmd|log|bak|backup|dist|ini|ya?ml))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Internal PHP libraries, tests, deployment helpers, and installed Composer
# packages must never be browsed directly. Internal require/include calls are
# filesystem operations and are not affected by these URL rules.
<IfModule mod_rewrite.c>
    RewriteRule ^(?:\.git|vendor|tests|cli|includes|config|docs)(?:/|$) - [F,L,NC]
</IfModule>

# SQL backups and PDF files are intentionally not covered here. They must be
# removed or relocated outside the public document root before deployment.
