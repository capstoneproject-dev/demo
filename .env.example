# Copy these names into your hosting provider's Environment Variables or
# Secrets settings. Do not put a real key in this committed example file.

# Optional when a reverse proxy serves the app from a subdirectory.
# Leave unset when automatic path detection works or the app is at domain root.
CAPSTONE_BASE_PATH=/CAPSTONE/demo

# Optional private document/printing-file location. For strongest production isolation, set this
# to a persistent writable directory outside the public document root.
CAPSTONE_PRIVATE_STORAGE_ROOT=/path/outside/public_html/capstone-private

# Public HTTPS origin and optional subdirectory used in 72-hour OSA invitation links.
APP_BASE_URL=https://example.edu/CAPSTONE/demo

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_account
SMTP_PASSWORD=replace_with_smtp_app_password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=replace_with_official_sender
SMTP_FROM_NAME=NAAP Account Security

ANALYTICS_AI_GEMINI_API_KEY=replace_with_a_new_rotated_key
ANALYTICS_AI_GEMINI_MODEL=gemini-2.5-flash
ANALYTICS_AI_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
